# Backend base URL (see backend/README.md)
# Leave empty in development: the Vite dev server passes /api and /ws to the backend at
# http://localhost:3000 (vite.config.js), which also lets phones on the same network use the app.
# Set it when the built app talks to an API on another address, e.g. https://api.example.com
VITE_API_BASE_URL=
