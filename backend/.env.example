# ---- aisstream.io (get a free key at https://aisstream.io) ----
AISSTREAM_API_KEY=
# JSON list of boxes, each [[lat1, lon1], [lat2, lon2]] (aisstream order: latitude first).
# Default: Indian coastline / EEZ (Arabian Sea + Bay of Bengal).
AIS_BBOXES=[[[-90,-180],[90,180]]]

# ---- Database (Supabase) ----
# Supabase dashboard → Connect → "Session pooler" URI (IPv4-friendly; NOT the transaction pooler on :6543).
# Enable the PostGIS extension first: Database → Extensions → postgis.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tables live in this schema; Supabase's REST API does not expose it.
DB_SCHEMA=ais
# Optional: path to Supabase's CA certificate (Database → SSL) for full TLS verification.
# DATABASE_SSL_CA=./prod-ca-2021.crt
DATABASE_POOL_MAX=5

# ---- Redis ----
# Local: brew services start redis
REDIS_URL=redis://localhost:6379
# Upstash (production): use the TLS scheme rediss:// with the database password from the Upstash console
# REDIS_URL=rediss://default:<password>@<your-db>.upstash.io:6379

# ---- API ----
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Set true once the frontend has a login screen. Writes always require auth.
AUTH_REQUIRED_FOR_READS=false
# Self-service sign-up from the login page (new accounts are always viewers)
ALLOW_REGISTRATION=true
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# ---- Ingestion & alerts ----
FLUSH_INTERVAL_MS=1000
FLUSH_MAX_ROWS=2000
MAX_BUFFER=50000
AIS_GAP_MINUTES=30
ALERT_COOLDOWN_MINUTES=15

# ---- Seed admin (npm run seed:admin) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

LOG_LEVEL=info

# Storage (worldwide AIS ~4.75M positions/day). Defaults fit the Supabase free tier (500 MB):
# raw rows for a few hours, then packed 6-hour tracks (~20 B/point) for TRACKS_RETENTION_DAYS.
POSITIONS_SAMPLE_SECONDS=120
RAW_RETENTION_HOURS=3
TRACKS_RETENTION_DAYS=3
LATEST_RETENTION_DAYS=7
DB_SIZE_LIMIT_MB=500
