{
  "name": "coastal-surveillance-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "predev": "tsx scripts/preflight.ts",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:ingestor": "tsx watch src/bin/ingestor.ts",
    "start:api": "node dist/bin/api.js",
    "start:ingestor": "node dist/bin/ingestor.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/bin/migrate.ts",
    "seed:admin": "tsx src/bin/seed-admin.ts",
    "capture": "tsx scripts/capture-aisstream.ts",
    "replay": "tsx scripts/replay-fixture.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/websocket": "^11.3.7",
    "@google/genai": "^3.6.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
